---
import { Icon } from 'astro-icon/components'

interface SocialLink {
	link: string
	name: string
	icon: string
	username: string
}

interface FooterProps {
	socialElements: SocialLink[]
	restaurantName: string
	year?: number
}

const { socialElements, restaurantName, year = new Date().getFullYear() } = Astro.props

const legalLinks = [
	{ href: '/aviso-legal', title: 'Aviso legal' },
	{ href: '/politica-de-privacidad', title: 'Política de privacidad' },
	{ href: '/politica-de-cookies', title: 'Política de cookies' },
]
---

<footer class="bg-bg text-secondary px-6 py-10 mt-auto border-t border-primary/5">
	<div class="max-w-5xl mx-auto flex flex-col items-center gap-8 lg:flex-row lg:justify-between lg:items-center">

		<!-- Izquierda: marca -->
		<div class="flex flex-col items-center gap-1 lg:items-start">
			<span class="text-2xl font-display font-semibold text-primary tracking-wide">{restaurantName}</span>
			<p class="text-xs text-accent/55 tracking-widest uppercase">Cocina de siempre, con alma propia</p>
		</div>

		<!-- Centro: el blog. Solo se enlaza desde aquí, no desde el navbar:
		     a él se llega desde Google, no navegando por la web. -->
		<div class="flex flex-col items-center gap-3">
			<p class="text-xs font-semibold uppercase tracking-widest text-accent/45">Descubre</p>
			<a href="/blog" class="flex items-center gap-1.5 text-sm hover:text-accent transition-colors">
				<Icon name="lucide:newspaper" class="size-4" />
				Blog del Rincón
			</a>
		</div>

		<!-- Derecha: redes -->
		<div class="flex flex-col items-center gap-3 lg:items-end">
			<p class="text-xs font-semibold uppercase tracking-widest text-accent/45">Síguenos</p>
			<ul class="flex gap-5">
				{socialElements.map((social: SocialLink) => (
					<li>
						<a href={social.link} target="_blank" rel="noopener noreferrer" aria-label={social.name}
							class="flex items-center gap-1.5 text-sm hover:text-accent transition-colors">
							<Icon name={social.icon} class="size-4" />
							@{social.username}
						</a>
					</li>
				))}
			</ul>
		</div>

	</div>
	<p class="text-xs text-secondary/30 text-center mt-8 max-w-5xl mx-auto">&copy; {year} {restaurantName}. Todos los derechos reservados.</p>
	<nav aria-label="Información legal" class="mt-2 max-w-5xl mx-auto">
		<ul class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs text-secondary/30">
			{legalLinks.map((l) => (
				<li><a href={l.href} class="underline decoration-transparent underline-offset-2 transition-colors hover:decoration-current hover:text-secondary/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current focus-visible:rounded-sm">{l.title}</a></li>
			))}
		</ul>
	</nav>
	<p class="text-xs text-secondary/30 text-center mt-2 max-w-5xl mx-auto">Creada por <a href="https://propus.es/" target="_blank" rel="noopener" class="underline decoration-transparent underline-offset-2 transition-colors hover:decoration-current hover:text-secondary/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current focus-visible:rounded-sm">Propus<span class="sr-only"> (se abre en una pestaña nueva)</span></a></p>
</footer>
