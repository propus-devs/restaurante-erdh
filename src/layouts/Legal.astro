---
// Marco de las páginas legales (aviso legal, privacidad, cookies). Mismo cabezal,
// pie y tipografías que el resto de la web; sin enlace desde el menú (solo desde el pie).
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { headerElements, footerSocial, contactPhone } from "../data/nav";

interface Props {
  /** <title> */
  title: string;
  description: string;
  /** H1 visible */
  titulo: string;
  actualizado: string;
}

const { title, description, titulo, actualizado } = Astro.props;
---

<Layout restaurantName="El Rincón de Héctor" seo={{ title, description, noindex: true }}>
  <Header slot="header" elements={headerElements} phone={contactPhone} socialElements={footerSocial} />

  <header class="px-6 pt-32 pb-8">
    <div class="mx-auto max-w-3xl">
      <nav class="legal-migas mb-6" aria-label="Migas de pan">
        <a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">{titulo}</span>
      </nav>
      <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">Información legal</p>
      <h1 class="font-display text-4xl leading-tight font-bold text-primary md:text-6xl">{titulo}</h1>
      <p class="mt-4 text-sm text-secondary/60">Última actualización: {actualizado}</p>
    </div>
  </header>

  <div class="mx-auto max-w-3xl px-6 pb-24">
    <div class="legal-prose"><slot /></div>
  </div>

  <Footer slot="footer" socialElements={footerSocial} restaurantName="El Rincón de Héctor" />
</Layout>

<style is:global>
  .legal-prose {
    --lp-fg: var(--color-secondary, #d4d4d4);
    --lp-strong: var(--color-primary, #ffffff);
    --lp-head-font: var(--font-display, "Cormorant Garamond", serif);
    --lp-body-font: var(--font-body, "Jost", sans-serif);
    --lp-accent: var(--color-accent-light, #dd9348);
    --lp-link: var(--color-accent-soft, #f0b06b);
    --lp-line: rgba(255, 255, 255, 0.1);
    --lp-card: rgba(255, 255, 255, 0.03);
  }
  .legal-prose h2 { font-weight: 700; }
  .legal-migas { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.8rem; color: rgba(212, 212, 212, 0.6); }
  .legal-migas a { text-decoration: underline; text-underline-offset: 3px; }
  .legal-migas a:hover { color: var(--color-accent-soft, #f0b06b); }
  /* Lectura cómoda: unos 70 caracteres por línea; las tablas pasan a tarjetas en móvil. */
.legal-prose { color: var(--lp-fg); font-family: var(--lp-body-font); font-size: 1.0625rem; line-height: 1.75; overflow-wrap: break-word; }
.legal-prose h2 { font-family: var(--lp-head-font); color: var(--lp-strong); font-size: clamp(1.45rem, 2.6vw, 1.85rem); line-height: 1.2; margin: 2.75rem 0 0.8rem; scroll-margin-top: 6rem; }
.legal-prose h3 { font-family: var(--lp-head-font); color: var(--lp-strong); font-size: 1.15rem; line-height: 1.3; margin: 1.6rem 0 0.4rem; }
.legal-prose p, .legal-prose ul, .legal-prose ol, .legal-prose dl { max-width: 70ch; }
.legal-prose p { margin: 0 0 1rem; }
.legal-prose ul, .legal-prose ol { margin: 0 0 1rem; padding-left: 1.3rem; }
.legal-prose ul { list-style: disc; }
.legal-prose ol { list-style: decimal; }
.legal-prose li { margin-bottom: 0.4rem; }
.legal-prose strong { color: var(--lp-strong); font-weight: 700; }
.legal-prose a { color: var(--lp-link); text-decoration: underline; text-underline-offset: 3px; }
.legal-prose a:hover { opacity: 0.85; }
.legal-prose a:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 2px; }
.legal-prose code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; background: var(--lp-card); padding: 0.1em 0.35em; border-radius: 0.25em; }

/* Datos del titular */
.legal-datos { margin: 0 0 1.25rem; border: 1px solid var(--lp-line); border-radius: 0.6rem; background: var(--lp-card); overflow: hidden; }
.legal-fila { display: grid; grid-template-columns: 10.5rem 1fr; gap: 1rem; padding: 0.75rem 1rem; border-top: 1px solid var(--lp-line); }
.legal-fila:first-child { border-top: 0; }
.legal-fila dt { color: var(--lp-accent); font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding-top: 0.3rem; }
.legal-fila dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }

/* Campos pendientes: que se vean */
.legal-pendiente { background: #fde047; color: #1a1a1a; font-weight: 700; padding: 0.05em 0.35em; border-radius: 0.25em; }

/* Tablas */
.legal-tabla { margin: 1rem 0 1.75rem; }
.legal-tabla table { width: 100%; border-collapse: collapse; font-size: 0.95rem; line-height: 1.55; }
.legal-tabla th, .legal-tabla td { text-align: left; vertical-align: top; padding: 0.75rem 0.85rem; border-top: 1px solid var(--lp-line); }
.legal-tabla th { color: var(--lp-accent); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; border-top: 0; border-bottom: 1px solid var(--lp-line); }

@media (max-width: 760px) {
  .legal-fila { grid-template-columns: 1fr; gap: 0.15rem; }
  .legal-tabla thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .legal-tabla table, .legal-tabla tbody, .legal-tabla tr, .legal-tabla td { display: block; width: 100%; }
  .legal-tabla tr { border: 1px solid var(--lp-line); border-radius: 0.6rem; background: var(--lp-card); margin-bottom: 0.9rem; padding: 0.3rem 0; }
  .legal-tabla td { border-top: 0; padding: 0.45rem 0.9rem; }
  .legal-tabla td::before { content: attr(data-label); display: block; color: var(--lp-accent); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.1rem; }
}

</style>
